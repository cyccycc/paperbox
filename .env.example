# SQLite 文件。路径相对于 prisma/ 目录。
DATABASE_URL="file:./dev.db"

# 登录会话签名。生产环境请换成足够长的随机字符串。变量名是 AUTH_SECRET，不是 SESSION_SECRET。
AUTH_SECRET="paperbox-dev-secret-change-in-production"

# 登录 Cookie 是否带 Secure。纯 HTTP（反向代理未开 TLS）保持 false。
# 浏览器会丢掉 HTTP 页面上的 Secure Cookie，登录成功后会立刻回到 /login。
# 站点改为 HTTPS 之后再设为 true。
COOKIE_SECURE="false"

# 可选。退出登录的回跳根地址，例如 https://paper.cyccycc.xyz
# 反向代理已经转发 Host 与 X-Forwarded-Proto 时留空：退出会回到用户当前打开的那个站点。
# 只有请求 Host 仍是 localhost，且 NODE_ENV=production 时才会用到。本地开发留空。
# 也接受 NEXTAUTH_URL 作为别名。
AUTH_URL=""

# 留空则全程使用离线解析。填入密钥后走 DeepSeek。不要提交真实密钥。
OPENAI_API_KEY=""

# 必须包含 /v1。纸匣会请求 ${OPENAI_BASE_URL}/chat/completions，不会再补一层 /v1。
OPENAI_BASE_URL="https://api.deepseek.com/v1"

# 当前推荐的 DeepSeek 对话模型。deepseek-chat 已停用。
OPENAI_MODEL="deepseek-flash"

# 新用户免费成功提取次数。默认 10。设为 0 则注册后没有免费额度。
FREE_QUOTA="10"

# 个人收款码图片。留空则购买页不显示该渠道。
# 站点内文件：把图片放到 public/pay/alipay.png，然后写成 /pay/alipay.png。说明见 public/pay/README.md。
# 也可以填 https 图片地址。不要提交真实收款码。
# 支付宝三项商户配置都填上之后，支付宝走收银台，不再用这里的支付宝收款码。微信仍用收款码。
PAYMENT_ALIPAY_QR_URL=""
PAYMENT_WECHAT_QR_URL=""

# 支付宝电脑网站支付 / 手机网站支付。APPID、应用私钥、支付宝公钥都填上才走收银台。
# 缺任意一项时，支付宝仍用上面的个人收款码。不要提交真实密钥。
# 开放平台用公钥模式（不是证书）。支付宝公钥是开放平台给出的那一串，不是应用公钥。
ALIPAY_APP_ID=""
# 应用私钥。PKCS8（密钥工具默认）或 PKCS1 的 PEM。一行也可以，换行写成 \n。
ALIPAY_PRIVATE_KEY=""
# 没有 PEM 头时按这个格式解析。默认 PKCS8。密钥工具选了 PKCS1 再改成 PKCS1。
ALIPAY_PRIVATE_KEY_TYPE="PKCS8"
# 支付宝公钥。
ALIPAY_PUBLIC_KEY=""
# 可选。只接受下面这个正式网关，或沙箱 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
# 可选。异步通知，必须是 https。留空则用当前 https 站点拼 /api/billing/alipay/notify
# 例如 https://paper.cyccycc.xyz/api/billing/alipay/notify
ALIPAY_NOTIFY_URL=""
# 可选。付完回跳，必须是 https。留空则用当前 https 站点拼 /api/billing/alipay/return
ALIPAY_RETURN_URL=""
# 可选。收款支付宝用户号，2088 开头共 16 位。填了就会在通知里核对，对不上不入账。
ALIPAY_SELLER_ID=""

# 可选。发放额度，以及核对「我已付款」后把订单标成已支付。不是支付商户密钥。
# 留空则 /api/admin/credits 关闭。
# Authorization: Bearer <ADMIN_GRANT_SECRET>
ADMIN_GRANT_SECRET=""

# 仅 npm run seed:admin 读取。写入账号 9999 的密码，至少 8 位。不要提交真实密码。
ADMIN_SEED_PASSWORD=""
