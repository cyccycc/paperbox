generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  /// Remaining successful parses. Existing rows receive 10; registration sets FREE_QUOTA.
  credits      Int            @default(10)
  /// Operator access to /admin. Existing rows stay false.
  isAdmin      Boolean        @default(false)
  createdAt    DateTime       @default(now())
  jobs         Job[]
  orders       Order[]
  ledger       CreditLedger[]
}

model Job {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  originalName   String
  storedName     String
  status         String
  mode           String
  fallbackReason String?
  message        String?
  resultJson     String?
  rewrite        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

/// Personal QR checkout. Pending orders do not add credits until mark_paid.
model Order {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId      String
  credits     Int
  amountCents Int
  currency    String    @default("CNY")
  channel     String
  status      String    @default("pending")
  /// Payer note submitted with 我已付款. Null until the user claims payment.
  note        String?
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
}

model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  jobId     String?  @unique
  orderId   String?  @unique
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
